            "consolidated_metadata": {
                "kind": "inline",
                "must_understand": false,
                "metadata": {}
            }
        },
        "scale0/image/.zarray": {
            "zarr_format": 2,
            "shape": [
                17,
                19,
                21
            ],
            "chunks": [
                17,
                19,
                21
            ],
            "dtype": "<u2",
            "compressor": {
                "id": "zstd",
                "level": 0
            },
            "fill_value": 0,
            "order": "C",
            "filters": null,
            "dimension_separator": "/"
        },
        "scale0/image/.zattrs": {}
    },
    "zarr_consolidated_format": 1
}