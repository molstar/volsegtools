                        "version": "2.0.2"
                    },
                    "@type": "ngff:Image"
                }
            ]
        },
        ".zgroup": {
            "zarr_format": 2
        },
        "scale0/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "z",
                "y",
                "x"
            ]
        },
        "scale0/.zgroup": {
