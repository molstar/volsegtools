{
    "metadata": {
        ".zattrs": {
            "multiscales": [
                {
                    "axes": [
                        {
                            "name": "z",
                            "type": "space",
                            "unit": "micrometer"
                        },
                        {
                            "name": "y",
                            "type": "space",
                            "unit": "micrometer"
                        },
                        {
                            "name": "x",
                            "type": "space",
                            "unit": "micrometer"
                        }
                    ],
                    "datasets": [
                        {
                            "path": "scale0/image",
                            "coordinateTransformations": [
